<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/TextAppearance.MeuCurso.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detalhes_disciplina" />

        <TextView
            android:id="@+id/textNomeDisciplina"
            style="@style/TextAppearance.MeuCurso.Title.Left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/programacao" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_info"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textCargaHoraria"
                style="@style/TextAppearance.MeuCurso.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/carga_horaria_exemplo" />

            <TextView
                android:id="@+id/textModalidade"
                style="@style/TextAppearance.MeuCurso.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/modalidade" />

            <TextView
                android:id="@+id/textNivel"
                style="@style/TextAppearance.MeuCurso.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nivel_exemplo" />

            <TextView
                android:id="@+id/textPreRequisito"
                style="@style/TextAppearance.MeuCurso.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pre_requisito_exemplo" />

        </LinearLayout>

        <TextView
            style="@style/TextAppearance.MeuCurso.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/descricao" />

        <TextView
            android:id="@+id/textDescricaoDisciplina"
            style="@style/TextAppearance.MeuCurso.Body.Left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/descricao_programacao" />

        <Button
            android:id="@+id/buttonVoltar"
            style="@style/Widget.MeuCurso.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/voltar" />

        <Button
            android:id="@+id/buttonVoltarHome"
            style="@style/Widget.MeuCurso.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voltar_home" />

    </LinearLayout>

</ScrollView>
